# Optional: API providers (or set them in the UI → Providers)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Where projects are stored (default ~/.pixel-studio)
PIXEL_STUDIO_HOME=
# Extra sprite folders offered as start sprites (":"-separated)
PIXEL_STUDIO_LIBRARY=
# Port (default 5178) and python interpreter with Pillow
PORT=5178
PXL_PYTHON=python3
# Concurrency per provider
PS_LIMIT_CLAUDE=3
PS_LIMIT_OPENCODE=2
